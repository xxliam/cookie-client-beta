{
	"schemaVersion": 1,
	"id": "cookie-client",
	"version": "${version}",
	"name": "Cookie Client",
	"description": "A Fabric PVP client for Minecraft 1.20.1, written in Java.",
	"authors": [
		"xxliam"
	],
	"contact": {
		"homepage": "https://github.com/xxliam",
		"sources": "https://github.com/xxliam/cookie-client"
	},
	"license": "CC-BY-NC-SA-4.0",
	"icon": "assets/cookie-client/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"xxliam.cookieclient.CookieClient"
		],
		"client": [
			"info.u_team.oauth_account_manager.OAuthAccountManagerMod"
		]
	},
	"accessWidener": "cookie-client.accesswidener",
	"mixins": [
		"cookie-client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"uteamcore": ">=5.1.3.267"
	}
}
